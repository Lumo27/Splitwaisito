rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function hasAcceptedCurrentTerms() {
      return authenticated()
        && exists(/databases/$(database)/documents/aceptacionesTerminos/$(request.auth.uid))
        && get(/databases/$(database)/documents/aceptacionesTerminos/$(request.auth.uid)).data.estado == 'aceptado';
    }

    function isGroupMember(groupId) {
      return hasAcceptedCurrentTerms()
        && exists(/databases/$(database)/documents/grupos/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/grupos/$(groupId)).data.miembros;
    }

    function isMemberOfCurrentGroup() {
      return hasAcceptedCurrentTerms()
        && request.auth.uid in resource.data.miembros;
    }

    match /usuarios/{userId} {
      allow read, write: if authenticated() && request.auth.uid == userId;
    }

    match /aceptacionesTerminos/{userId} {
      function acceptanceIsValid() {
        return request.resource.data.keys().hasOnly([
            'usuarioId',
            'version',
            'estado',
            'acceptedAt'
          ])
          && request.resource.data.keys().hasAll([
            'usuarioId',
            'version',
            'estado',
            'acceptedAt'
          ])
          && request.resource.data.usuarioId == userId
          && request.resource.data.version == '1.0.2'
          && request.resource.data.estado == 'aceptado'
          && request.resource.data.acceptedAt == request.time;
      }

      allow read: if authenticated() && request.auth.uid == userId;
      allow create: if authenticated()
        && request.auth.uid == userId
        && acceptanceIsValid();
      allow update: if authenticated()
        && request.auth.uid == userId
        && acceptanceIsValid()
        && resource.data.get('estado', '') != 'aceptado';
      allow delete: if false;
    }

    match /solicitudesAmistad/{solicitudId} {
      allow create: if hasAcceptedCurrentTerms()
        && request.auth.uid == request.resource.data.emisorId;
      allow read: if hasAcceptedCurrentTerms()
        && (request.auth.uid == resource.data.emisorId
          || request.auth.token.email == resource.data.destinatarioEmail);
      allow update: if hasAcceptedCurrentTerms()
        && request.auth.token.email == resource.data.destinatarioEmail;
      allow delete: if hasAcceptedCurrentTerms()
        && (request.auth.uid == resource.data.emisorId
          || request.auth.token.email == resource.data.destinatarioEmail);
    }

    match /amistades/{amistadId} {
      allow read: if hasAcceptedCurrentTerms()
        && request.auth.uid in resource.data.miembros;
      allow create: if hasAcceptedCurrentTerms()
        && request.auth.uid in request.resource.data.miembros;
      allow delete: if hasAcceptedCurrentTerms()
        && request.auth.uid in resource.data.miembros;
    }

    match /grupos/{groupId} {
      allow create: if hasAcceptedCurrentTerms()
        && request.auth.uid in request.resource.data.miembros;
      allow read: if isMemberOfCurrentGroup();
      allow update: if isMemberOfCurrentGroup();
      allow delete: if isMemberOfCurrentGroup();

      match /gastos/{gastoId} {
        allow read, create, delete: if isGroupMember(groupId);
        // El estado de un pago (aprobado o rechazado) solo lo cambia quien
        // recibe el dinero, que es el único participante del pago.
        allow update: if isGroupMember(groupId)
          && (resource.data.get('tipo', 'gasto') != 'pago'
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado'])
            || request.auth.uid in resource.data.participantes);

        match /fotos/{fotoId} {
          allow read, create, update, delete: if isGroupMember(groupId);
        }
      }
    }
  }
}
