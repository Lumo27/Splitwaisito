rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return authenticated()
        && exists(/databases/$(database)/documents/grupos/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/grupos/$(groupId)).data.miembros;
    }

    function isMemberOfCurrentGroup() {
      return authenticated() && request.auth.uid in resource.data.miembros;
    }

    match /usuarios/{userId} {
      allow read, write: if authenticated() && request.auth.uid == userId;
    }

    match /solicitudesAmistad/{solicitudId} {
      allow create: if authenticated()
        && request.auth.uid == request.resource.data.emisorId;
      allow read: if authenticated()
        && (request.auth.uid == resource.data.emisorId
          || request.auth.token.email == resource.data.destinatarioEmail);
      allow update: if authenticated()
        && request.auth.token.email == resource.data.destinatarioEmail;
      allow delete: if authenticated()
        && (request.auth.uid == resource.data.emisorId
          || request.auth.token.email == resource.data.destinatarioEmail);
    }

    match /amistades/{amistadId} {
      allow read: if authenticated()
        && request.auth.uid in resource.data.miembros;
      allow create: if authenticated()
        && request.auth.uid in request.resource.data.miembros;
      allow delete: if authenticated()
        && request.auth.uid in resource.data.miembros;
    }

    match /grupos/{groupId} {
      allow create: if authenticated()
        && request.auth.uid in request.resource.data.miembros;
      allow read: if isMemberOfCurrentGroup();
      allow update: if isMemberOfCurrentGroup();
      allow delete: if isMemberOfCurrentGroup();

      match /gastos/{gastoId} {
        allow read, create, delete: if isGroupMember(groupId);
        // El estado de un pago (aprobado o rechazado) solo lo cambia quien
        // recibe el dinero, que es el único participante del pago.
        allow update: if isGroupMember(groupId)
          && (resource.data.get('tipo', 'gasto') != 'pago'
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado'])
            || request.auth.uid in resource.data.participantes);

        match /fotos/{fotoId} {
          allow read, create, update, delete: if isGroupMember(groupId);
        }
      }

      match /transferencias/{transferenciaId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.auth.uid == request.resource.data.deudorId
          && request.resource.data.acreedorId in get(/databases/$(database)/documents/grupos/$(groupId)).data.miembros
          && request.resource.data.deudorId != request.resource.data.acreedorId
          && request.resource.data.monto is number
          && request.resource.data.monto > 0
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.fechaCreacion is string
          && get(/databases/$(database)/documents/grupos/$(groupId)).data
            .get('transferenciasPendientes', []).size() < 10
          && getAfter(/databases/$(database)/documents/grupos/$(groupId)).data
            .get('transferenciasPendientes', []).size() <= 10
          && transferenciaId in getAfter(
            /databases/$(database)/documents/grupos/$(groupId)
          ).data.get('transferenciasPendientes', [])
          && request.resource.data.keys().hasOnly([
            'deudorId',
            'acreedorId',
            'monto',
            'estado',
            'fechaCreacion'
          ]);
        allow update: if isGroupMember(groupId)
          && request.auth.uid == resource.data.acreedorId
          && resource.data.estado == 'pendiente'
          && request.resource.data.estado in ['confirmada', 'rechazada']
          && request.resource.data.fechaRespuesta is string
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'fechaRespuesta'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasAll(['estado', 'fechaRespuesta'])
          && transferenciaId in get(
            /databases/$(database)/documents/grupos/$(groupId)
          ).data.get('transferenciasPendientes', [])
          && !(transferenciaId in getAfter(
            /databases/$(database)/documents/grupos/$(groupId)
          ).data.get('transferenciasPendientes', []));
      }
    }
  }
}
